# Trace a Life - local secrets and provider configuration
#
# Copy this file to `.env` and fill values locally:
#   cp .env.example .env
#
# Never commit `.env` or paste its secrets into chat, logs, screenshots, or case files.

# -----------------------------------------------------------------------------
# Tencent Cloud ASR - primary provider
# https://cloud.tencent.com/document/product/1093/37823
# -----------------------------------------------------------------------------

# Required: create a least-privilege CAM sub-user/API key instead of using the
# root-account key.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# ASR Region is optional in Tencent Cloud's CreateRecTask API. Leave empty unless
# your SDK/account setup requires an explicit region.
TENCENTCLOUD_REGION=
TENCENT_ASR_ENDPOINT=asr.tencentcloudapi.com

# Free-quota route: Mandarin general engine with some English and anonymous
# speaker diarization. 16k_zh_en_2.0 has better multilingual/dialect coverage,
# but Tencent bills it as the large-model 2.0 product with no monthly free quota.
TENCENT_ASR_ENGINE_MODEL_TYPE=16k_zh
TENCENT_ASR_CHANNEL_NUM=1

# 3 = word timestamps + punctuation + punctuation-based sentence segments.
# Do not set 4 or 5 while staying on the free path; those are paid add-ons.
TENCENT_ASR_RES_TEXT_FORMAT=3

# 1 = anonymous speaker diarization. SpeakerNumber 0 asks Tencent to infer the
# count automatically (up to 20). This produces Speaker IDs, not verified names.
TENCENT_ASR_SPEAKER_DIARIZATION=1
TENCENT_ASR_SPEAKER_NUMBER=0

# Polling is the default integration path. Leave callback empty unless a public,
# authenticated callback endpoint has been deployed.
TENCENT_ASR_CALLBACK_URL=
TENCENT_ASR_POLL_INTERVAL_SECONDS=5
TENCENT_ASR_RESULT_TIMEOUT_SECONDS=10800

# Optional temporary hotwords. Example syntax: 方言|11,金钱进化论|11
# Start blank and only add terms after measuring whether they improve accuracy.
TENCENT_ASR_HOTWORD_LIST=

# -----------------------------------------------------------------------------
# Tencent COS - required for interview audio larger than 5 MB
# -----------------------------------------------------------------------------

# Create a private bucket. The same CAM key may be used only if it has narrowly
# scoped PutObject/GetObject/DeleteObject permissions for this bucket/prefix.
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_BUCKET=
TENCENT_COS_PREFIX=trace-a-life/asr-input

# Tencent ASR fetches the object asynchronously through a presigned URL. Keep the
# URL alive through the download window, but do not make objects public. Delete
# only after the ASR task reaches a terminal state, never immediately on submit.
TENCENT_COS_PRESIGNED_URL_EXPIRES_SECONDS=14400
TENCENT_COS_DELETE_AFTER_COMPLETION=true

# -----------------------------------------------------------------------------
# Chapter generation - optional local/OpenAI-compatible model
# -----------------------------------------------------------------------------

# Example for a local OpenAI-compatible Qwen server. Leave blank until the
# chapter-generation stage is implemented/configured.
CHAPTER_LLM_BASE_URL=http://127.0.0.1:11434/v1
CHAPTER_LLM_API_KEY=
CHAPTER_LLM_MODEL=

# -----------------------------------------------------------------------------
# Optional backup ASR providers - keep all provider keys in this one local file
# -----------------------------------------------------------------------------

GLADIA_API_KEY=
SPEECHMATICS_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
