    "claims": {
      "claim-001": {
        "counterevidence": "用公司曾用名与登记号检索，未发现更早的同一法律实体；品牌更早出现但属于贸易个体户。",
        "evidence": [
          {
            "quote": "南浦机械有限公司于1998年4月18日设立，林深认缴60%，周岚认缴40%。",
            "source_id": "src-001"
          }
        ],
        "explanation": "设立登记直接记录了成立日期、股东与比例。",
        "id": "claim-001",
        "importance": "critical",
        "independent_origin_clusters": 1,
        "source_ids": [
          "src-001"
        ],
        "status": "verified",
        "text": "林深与周岚于1998年共同设立南浦机械，林深持有60%登记股权。"
      },
      "claim-002": {
        "counterevidence": "检索1988–1992年地方工商摘要与行业报刊，尚未找到对应金额或交易对手。",
        "evidence": [
          {
            "quote": "真正让我有了周转本钱的，是1989年那批压在港口的轴承。",
            "source_id": "src-002"
          }
        ],
        "explanation": "目前只能追溯到林深本人2009年的回忆，没有同期账簿或独立报道。",
        "id": "claim-002",
        "importance": "critical",
        "independent_origin_clusters": 1,
        "source_ids": [
          "src-002"
        ],
        "status": "self_reported",
        "text": "林深的第一笔主要资本来自1989年的一批进口轴承转售。"
      },
      "claim-003": {
        "counterevidence": "没有证据支持后来采访中“完全靠自有现金拿下”的绝对说法。",
        "evidence": [
          {
            "quote": "园区对南浦机械的存量设备承接项目给予技改补贴，并协调两家银行提供项目授信。",
            "source_id": "src-003"
          },
          {
            "quote": "交易资金由企业自有资金、园区技改支持和新增授信三部分构成。",
            "source_id": "src-004"
          }
        ],
        "explanation": "园区年度文件与同期独立报道来自两个不同源头，均指向补贴和授信。",
        "id": "claim-003",
        "importance": "critical",
        "independent_origin_clusters": 2,
        "source_ids": [
          "src-003",
          "src-004"
        ],
        "status": "credible",
        "text": "2003年的逆周期收购同时依赖地方设备补贴和新增银行授信，而非完全由个人现金完成。"
      },
      "claim-004": {
        "counterevidence": "债务重组公告与后来的公司回顾在动机表述上存在差异。",
        "evidence": [
          {
            "quote": "公司将出售两项非核心资产，并以所得资金偿还到期借款；主要债权人同意将剩余借款展期十八个月。",
            "source_id": "src-005"
          }
        ],
        "explanation": "业务确实收缩，但公告显示它与债务展期和资产出售同步发生，不能只写成主动战略升级。",
        "id": "claim-004",
        "importance": "supporting",
        "independent_origin_clusters": 1,
        "source_ids": [
          "src-005"
        ],
        "status": "partial",
        "text": "2017年的业务收缩是一次主动且从容的战略选择。"
      },
      "claim-005": {
        "counterevidence": "未发现下一代已获得日常经营职位的证据；公开材料支持“制度化分权”而不是简单父传女。",
        "evidence": [
          {
            "quote": "相关股份的经济受益权归各受益人所有，投票权由林氏长期信托依据信托契约统一行使。",
            "source_id": "src-006"
          },
          {
            "quote": "董事会任命外部职业经理人顾言为首席执行官，林深不再参与日常经营。",
            "source_id": "src-007"
          }
        ],
        "explanation": "交易所文件直接记录投票权安排，独立产业媒体确认职业经理人接任。",
        "id": "claim-005",
        "importance": "critical",
        "independent_origin_clusters": 2,
        "source_ids": [
